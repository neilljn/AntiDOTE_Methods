  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "# true values of the paramters\n",
    "theta = np.array([0.1,1.5,0,0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "# true values of other inputs\n",
    "prop_0 = 0.3\n",
    "gamma = 0.5\n",
    "test_rate = 0.3 #will be replaced with other test data, but parameter needed for simulation\n",
    "sens = 0.95\n",
    "spec = 0.99"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "# seasonality modifiers\n",
    "seasonality_mode = 2\n",
    "seasonal_period = 52\n",
    "t_ast = 17\n",
    "\n",
    "# resulting matrices\n",
    "seasonal_vector = np.array([1 - np.cos(2*np.pi*(t+t_ast)/seasonal_period) for t in range(T+1)])\n",
    "seasonal_matrix_G = np.tile(seasonal_vector, (N,1)).T\n",
    "seasonal_matrix_H = np.tile(1, (T+1,N))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "# simulating the data\n",
    "UC_results = UC_sim(N,h,age,sex,prop_0,theta,gamma,test_rate,sens,spec,T,seasonality_mode,seasonal_period,t_ast,1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "# creating a test result matrix\n",
    "random.seed(256)\n",
    "test_occurance = test_results_real*0 + 1\n",
    "pos_prob = sens*UC_results['X'] + (1-spec)*(1-UC_results['X'])\n",
    "test_outcome = random.binomial(1,pos_prob)\n",
    "test_results = test_outcome * test_occurance"
   ]
